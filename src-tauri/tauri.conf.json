{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Workbench",
  "version": "0.2.31",
  "identifier": "com.claudeworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run build:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Claude Code 管理与对话工作站",
    "resources": {
      "../resources/workbench/": "workbench/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
